{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniTerm",
  "version": "0.1.0",
  "identifier": "dev.miniterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "MiniTerm", "width": 1200, "height": 760, "decorations": false, "minWidth": 600, "minHeight": 360, "backgroundColor": "#1b1d23" }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
